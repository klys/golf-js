# Noise Golf 2D 0010 - Cliente/Host web
# ESTE .env ES PUBLICO: el navegador lo descarga. NO pongas contraseñas privadas, tokens ni secretos aquí.

NG_ONLINE_ENABLED=true
NG_MAX_PLAYERS=16

# Relay público obligatorio para discovery/señalización.
# Producción HTTPS: usa wss://
NG_RELAY_URL=ws://127.0.0.1:8787
NG_RELAY_CONNECT_TIMEOUT_MS=6500
NG_PREFLIGHT_TIMEOUT_MS=6500

# ICE WebRTC. Para Internet real conviene STUN y TURN propio.
# Ejemplo: [{"urls":"stun:stun.tudominio.com:3478"}]
NG_PUBLIC_ICE_SERVERS_JSON=[]

# Sincronización/presentación cliente.
NG_SNAPSHOT_HZ=20
NG_RELIABLE_PING_SECONDS=2
NG_REQUEST_TIMEOUT_MS=6500
NG_WEBRTC_CONNECT_TIMEOUT_MS=14000

# Paso fijo de simulación. El host y la predicción local avanzan siempre en
# pasos de este tamaño, así que los FPS no alteran la física.
NG_SIMULATION_HZ=60

# Retardo mínimo de interpolación. El cliente dibuja el pasado reciente para
# tener siempre dos muestras que interpolar; sube solo si hay jitter alto.
NG_CLIENT_INTERPOLATION_MS=70
# Techo de extrapolación cuando se pierden paquetes.
NG_CLIENT_MAX_EXTRAPOLATION_MS=125
# Semivida de la corrección visual: más bajo = converge antes pero se nota más.
NG_CLIENT_CORRECTION_HALFLIFE_MS=105
# Predicción local de tu propia bola (recomendado true; false = todo desde el host).
NG_CLIENT_PREDICTION=true
NG_CLIENT_SMOOTHING_RESPONSIVENESS=18
NG_CLIENT_SNAP_DISTANCE=210

# Reconexión: el host reserva la plaza del jugador caído este tiempo y, al
# agotarse, lo elimina por completo de la partida. El relay debe conservar la
# reserva al menos igual de tiempo (PARTICIPANT_RESUME_SECONDS).
NG_PLAYER_GRACE_SECONDS=180

# Votación de mapa.
# El cambio tiene un enfriamiento fijo de 60 segundos.
NG_MAP_VOTE_TIMEOUT_SECONDS=30
